# Copy to .env.local (git-ignored) and fill in. Also set these in Vercel.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API). URL + anon key are public/safe.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role / secret key — SERVER ONLY, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string for migrations (Project Settings -> Database).
# Fill [YOUR-PASSWORD] with the DB password.
DATABASE_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Gemini Flash (Google AI Studio) — SERVER ONLY.
GEMINI_API_KEY=your-gemini-key

# PostHog (north-star analytics). Key is public; host is region-specific.
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
